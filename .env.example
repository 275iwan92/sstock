APP_NAME=Stoku
# Tahap aplikasi untuk label versi (ver 0.NNN A): alpha = dibangun dan dicoba tim sendiri, beta = UAT berjalan, rc = calon rilis, kosong = rilis.
APP_STAGE=alpha
# Bawaan berkas ini aman untuk produksi. Mesin pengembangan boleh memakai APP_ENV=local dan APP_DEBUG=true di .env sendiri.
# WAJIB diubah di produksi: APP_KEY (php artisan key:generate), APP_URL, DB_*, MAIL_*.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://sstock.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# WAJIB diganti di produksi: DB_PASSWORD (nilai di bawah hanya contoh) dan, bila perlu, host/nama database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sstock
DB_USERNAME=sstock_usr
DB_PASSWORD=sstock1234
# Akun admin MySQL, hanya dipakai "php artisan sstock:install" untuk membuat database + user di atas (tidak dipakai aplikasi).
# Kosongkan DB_ADMIN_PASSWORD bila root tanpa password; bila tidak diisi, installer menanyakannya.
DB_ADMIN_USERNAME=root
DB_ADMIN_PASSWORD=

SESSION_DRIVER=database
# Menit tanpa aktivitas sebelum pengguna keluar otomatis.
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Surel (lupa password). WAJIB di produksi: MAIL_MAILER=smtp dan isi MAIL_*; log = hanya ditulis ke storage/logs/laravel.log (pengembangan).
# Contoh Gmail (perlu "Sandi aplikasi" 16 huruf, bukan sandi akun): MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SCHEME=null (STARTTLS) atau MAIL_PORT=465 + MAIL_SCHEME=smtps.
# MAIL_FROM_ADDRESS sebaiknya sama dengan MAIL_USERNAME (Gmail menulis ulang pengirim lain). MAIL_FROM_NAME dan subjek surel mengikuti APP_NAME.
# Uji: php artisan sstock:mail-test alamat@contoh.id. Setelah mengubah .env di server: php artisan optimize:clear && php artisan optimize.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Detik menunggu server SMTP (port tertutup tidak menggantung layar). MAIL_EHLO_DOMAIN: nama yang diperkenalkan ke SMTP, bawaan host APP_URL.
MAIL_TIMEOUT=15
# MAIL_EHLO_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Tombol "Segarkan data contoh" (menghapus SELURUH data) harus mati di produksi.
# Hanya di lingkungan uji: ubah menjadi SSTOCK_SAMPLE_REFRESH=true di .env lingkungan itu.
SSTOCK_SAMPLE_REFRESH=false

# Super admin tersembunyi: SATU-SATUNYA yang boleh menyegarkan data contoh (di production juga). Tidak tampil di layar Pengguna / Grup.
# Isi nama akun dan HASH bcrypt kata sandinya (php artisan tinker --execute="echo bcrypt('kata-sandi');"); jangan isi kata sandi polos. Kosong = fitur mati.
SSTOCK_SUPER_ADMIN=
SSTOCK_SUPER_ADMIN_HASH=

# Log Aktivitas (super admin) menampilkan perkiraan lokasi IP publik lewat ipwho.is (IP dikirim ke layanan itu, hasilnya di-cache). false = mati.
SSTOCK_IP_LOOKUP=true

VITE_APP_NAME="${APP_NAME}"
